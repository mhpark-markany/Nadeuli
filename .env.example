# 에어코리아 (data.go.kr)
AIRKOREA_API_KEY=your_airkorea_api_key

# 기상청 (data.go.kr)
KMA_API_KEY=your_kma_api_key

# 기상청 API허브 (apihub.kma.go.kr) — 중기예보 등
KMA_APIHUB_AUTH_KEY=your_kma_apihub_auth_key

# 한국관광공사 TourAPI 4.0 (data.go.kr)
TOUR_API_KEY=your_tour_api_key

# Redis (선택) — 비우면 인메모리 캐시만 쓴다. Vercel 배포는 기본으로 비워 둔다.
REDIS_URL=redis://localhost:6379

# Gemini (Phase 3) — 결제를 연결하지 않은 AI Studio 프로젝트의 키를 쓰면 무료 등급
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.1-flash-lite  # 선택, 기본값

# 서버
PORT=3000

# CORS (프론트엔드 URL)
CORS_ORIGIN=*

# Kakao REST API Key
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# Kakao OAuth
KAKAO_CLIENT_SECRET=your_kakao_client_secret

# JWT
JWT_SECRET=your_jwt_secret_generate_with_openssl_rand_base64_32

# Database (Neon PostgreSQL) — Vercel Marketplace 로 Neon 을 붙이면 Vercel 환경 변수에 자동으로 들어간다.
# DATABASE_URL: 앱이 쓰는 풀링(-pooler) 주소, DATABASE_URL_UNPOOLED: prisma migrate 가 쓰는 직접 연결 주소
DATABASE_URL=postgresql://user:xxx@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:xxx@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require